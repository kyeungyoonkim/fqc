# Copy this file to `.env` and fill in real values. Never commit the real
# `.env` file - it is already covered by .gitignore.

CTV_USERNAME=
CTV_PASSWORD=
DLT_USERNAME=
DLT_PASSWORD=
JC_USERNAME=
JC_PASSWORD=

# BotFather -> /newbot to create a bot and get this token
TELEGRAM_BOT_TOKEN=
# The chat/group/channel id to post the report to (use @userinfobot or
# https://api.telegram.org/bot<token>/getUpdates to find it)
TELEGRAM_CHAT_ID=

# Optional: command used to bring up the VPN before hitting DLT/JC.
# Examples:
#   Cisco AnyConnect (Windows, headless):
#     "\"C:/Program Files (x86)/Cisco/Cisco AnyConnect Secure Mobility Client/vpncli.exe\" -s < vpn_creds.txt"
#   OpenConnect (Linux):
#     "sudo openconnect --background --user=%VPN_USER% vpn.company.com"
VPN_CONNECT_COMMAND=
VPN_USERNAME=
VPN_PASSWORD=
